{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observeops.local/schemas/change_fact_v1.schema.json",
  "title": "change_fact.v1",
  "description": "A change that happened at a time, linked to a configuration item. Not a graph vertex.",
  "type": "object",
  "required": [
    "schema_version",
    "tenant",
    "change_id",
    "ci_id",
    "occurred_at",
    "change_kind"
  ],
  "properties": {
    "schema_version": { "const": "change_fact.v1" },
    "tenant": { "type": "string", "minLength": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "ci_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "minLength": 1 },
    "change_kind": {
      "type": "string",
      "enum": ["deploy", "config", "scale", "restart", "schema", "other"]
    },
    "summary": { "type": "string" },
    "source": { "type": "string" },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": true
}
