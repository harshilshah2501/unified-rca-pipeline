{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observeops.local/schemas/sketch_v1.schema.json",
  "title": "sketch.v1",
  "type": "object",
  "required": [
    "schema_version",
    "tenant",
    "entity_id",
    "metric_id",
    "window",
    "window_start",
    "season_key",
    "tdigest",
    "buckets",
    "baseline"
  ],
  "properties": {
    "schema_version": { "const": "sketch.v1" },
    "tenant": { "type": "string", "minLength": 1 },
    "entity_id": { "type": "string", "minLength": 1 },
    "entity_type": { "type": "string" },
    "metric_id": { "type": "string", "minLength": 1 },
    "window": { "enum": ["1m", "5m", "1h", "1d"] },
    "window_start": { "type": "string" },
    "window_end": { "type": "string" },
    "season_key": { "type": "string", "pattern": "^[A-Z][a-z]{2}-[0-2][0-9]:[0-5][0-9]$" },
    "sample_count": { "type": "integer", "minimum": 0 },
    "tdigest": {
      "type": "object",
      "required": ["encoding"],
      "properties": {
        "compression": { "type": "number" },
        "encoding": { "enum": ["centroids_json", "tdigest_bytes"] },
        "centroids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["m", "w"],
            "properties": {
              "m": { "type": "number" },
              "w": { "type": "number" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "buckets": {
      "type": "object",
      "required": ["bucket_schema_version", "bounds", "counts"],
      "properties": {
        "bucket_schema_version": { "type": "string" },
        "bounds": { "type": "array", "items": { "type": "number" }, "minItems": 2 },
        "counts": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["baseline_version", "expected_p50", "expected_p95", "expected_p99"],
      "properties": {
        "baseline_version": { "type": "string" },
        "expected_p50": { "type": "number" },
        "expected_p95": { "type": "number" },
        "expected_p99": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "not": {
    "anyOf": [
      { "required": ["src_ci_id"] },
      { "required": ["dst_ci_id"] },
      { "required": ["relation"] }
    ]
  },
  "additionalProperties": true
}
