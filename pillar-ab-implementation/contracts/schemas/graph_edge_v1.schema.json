{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observeops.local/schemas/graph_edge_v1.schema.json",
  "title": "graph_edge.v1",
  "type": "object",
  "required": [
    "schema_version",
    "tenant",
    "edge_id",
    "src_ci_id",
    "dst_ci_id",
    "relation",
    "discovered_via"
  ],
  "properties": {
    "schema_version": { "const": "graph_edge.v1" },
    "tenant": { "type": "string", "minLength": 1 },
    "edge_id": { "type": "string", "minLength": 1 },
    "src_ci_id": { "type": "string", "minLength": 1 },
    "dst_ci_id": { "type": "string", "minLength": 1 },
    "relation": {
      "type": "string",
      "enum": [
        "depends_on",
        "runs_on",
        "mounts",
        "connects_to",
        "backs",
        "uses",
        "hosted_on",
        "member_of",
        "part_of",
        "routes_through",
        "authenticates_via",
        "monitored_by",
        "backed_up_by",
        "clustered_with",
        "communicates_with"
      ]
    },
    "discovered_via": {
      "type": "object",
      "required": ["evidence_type"],
      "properties": {
        "evidence_type": { "enum": ["authoritative", "declared", "corroborating"] },
        "confidence": { "enum": ["high", "medium", "low", "n/a"] },
        "telemetry_source": { "type": "string" },
        "signal_fields": { "type": ["array", "string"] },
        "endpoint_binding": { "type": "string" },
        "direction_inference": { "type": "string" },
        "refresh": { "type": "string" }
      },
      "additionalProperties": true
    },
    "valid_from": { "type": ["string", "null"] },
    "valid_to": { "type": ["string", "null"] },
    "criticality": { "enum": ["critical", "high", "medium", "low"] }
  },
  "additionalProperties": true
}
