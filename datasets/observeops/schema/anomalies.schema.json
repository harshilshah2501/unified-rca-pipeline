{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observeops-anomalies",
  "title": "ObserveOps Anomaly Bundle",
  "type": "object",
  "required": ["incident_start", "anomalies"],
  "properties": {
    "incident_start": {
      "type": "string",
      "format": "date-time"
    },
    "anomalies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ci", "signal", "value", "threshold", "crossed", "timestamp"],
        "properties": {
          "ci": { "type": "string", "minLength": 1 },
          "signal": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "threshold": { "type": "number" },
          "crossed": { "type": "boolean" },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
