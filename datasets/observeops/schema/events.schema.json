{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observeops-events",
  "title": "ObserveOps Synthetic Events",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "ci", "event_type", "severity", "message"],
        "properties": {
          "timestamp": { "type": "string", "minLength": 1 },
          "ci": { "type": "string", "minLength": 1 },
          "event_type": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
