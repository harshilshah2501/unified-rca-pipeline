{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observeops-ground-truth",
  "title": "ObserveOps Ground Truth",
  "type": "object",
  "required": ["root_ci", "signature"],
  "properties": {
    "root_ci": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "string",
      "enum": [
        "cpu_contention",
        "link_failure",
        "network_saturation",
        "storage_contention",
        "os_resource_exhaustion",
        "app_resource_exhaustion"
      ]
    },
    "contributor_cis": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blast_radius": {
      "type": "array",
      "items": { "type": "string" }
    },
    "upstream_healthy": { "type": "boolean" },
    "fault_bucket": {
      "type": "string",
      "enum": ["1_symptom", "2_infra", "3_application", "4_external"],
      "description": "Coverage bucket (docs/FAULT_BUCKET_COVERAGE.md); optional for dashboard Samples"
    },
    "fault_type": {
      "type": "string",
      "minLength": 1,
      "description": "Fine-grained fault class within the bucket"
    },
    "fault_title": {
      "type": "string",
      "minLength": 1,
      "description": "Short human label for Samples / Incident Analysis"
    }
  },
  "additionalProperties": false
}
